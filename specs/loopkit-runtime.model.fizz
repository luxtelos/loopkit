# loopkit-runtime.model.fizz — journal-before-act, replay, two writers.
#
# CHECKED IN THIS REPO. The driver ships here:
#   node plugins/loopkit/skills/run-state-model/driver.mjs check \
#        specs/loopkit-runtime.model.fizz
# Expected verdict: PASS (exit 0). See specs/loopkit-runtime.md §Control case
# for the buggy twin that proves the checker can fail.
#
# The system: one Run executes one step against a Provider. The step is a side
# effect, so it must survive a crash without happening twice, and a resume must
# be answered from the journal rather than from the model.
#
#   intent      "I am about to call the provider"      journaled BEFORE the call
#   result      "the provider returned, here it is"    journaled AFTER the call
#   owner       the lease on the step; a conditional write (put_if_absent)
#   called      volatile — the provider returned but nothing is on disk yet
#
# The crash window is the gap between CallProvider and Commit. Everything this
# model exists to prove lives in that gap.

---
deadlock_detection: false
---

WRITERS = ["w1", "w2"]
MAX_CRASHES = 1
MAX_REPLAYS = 2

action Init:
    intent = 0
    result = 0
    owner = ""
    called = 0
    effects = 0
    provider_calls = 0
    calls_at_journal = 0
    crashes = 0
    replays = 0

# Journal the intent. put_if_absent: a second writer arriving here writes
# nothing, which is why this is atomic and guarded rather than a blind set.
atomic action JournalIntent:
    if intent == 0:
        intent = 1

# The Store's conditional write, used as a lease. Exactly one writer wins;
# the loser's put is REFUSED, never silently interleaved.
atomic action Claim:
    w = oneof WRITERS
    if intent == 1 and result == 0 and owner == "":
        owner = w

# Call the provider. Refuses unless the intent is already on disk — this is
# journal-BEFORE-act stated as a guard, not as a comment.
atomic action CallProvider:
    w = oneof WRITERS
    if owner == w and intent == 1 and result == 0 and called == 0:
        provider_calls = provider_calls + 1
        called = 1

# Journal the result and apply the side effect. The effect is a conditional
# write keyed by the step, so a redelivery converges instead of doubling.
# calls_at_journal is set BEFORE result so no interleaving can observe a
# journaled result next to a stale call count.
atomic action Commit:
    w = oneof WRITERS
    if owner == w and called == 1 and result == 0:
        if effects == 0:
            effects = effects + 1
        calls_at_journal = provider_calls
        result = 1

# The owner dies between the provider call and the result journal. The lease
# expires and `called` — which lived only in memory — is lost with it. Bounded
# so the state space is finite; one crash is enough to witness the property.
atomic action Crash:
    if result == 0 and crashes < MAX_CRASHES:
        crashes = crashes + 1
        owner = ""
        called = 0

# Resume: read the journal. A step whose RESULT is journaled is answered from
# the journal. Note what this action does NOT do: touch provider_calls.
atomic action Resume:
    if result == 1 and replays < MAX_REPLAYS:
        replays = replays + 1

# --- the three properties -------------------------------------------------

# No side effect happens twice, however the crash and the two writers
# interleave.
always assertion EffectAtMostOnce:
    return effects <= 1

# Journal before act: nothing is ever executed whose intent is not on disk.
# A crash that loses the whole process must still leave a record that the
# effect MAY have happened.
always assertion NoEffectWithoutJournaledIntent:
    if effects >= 1:
        return intent == 1
    return True

# Resume never re-calls the provider for a journaled step. Once the result is
# on disk the call count is frozen at what it was when the result was written.
always assertion NoProviderCallAfterJournaledResult:
    if result == 1:
        return provider_calls == calls_at_journal
    return True
