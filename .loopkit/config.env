# LoopKit's own gate. The suite is tests/selftest.sh; selftest-report.sh turns
# its ok/FAIL lines into a jest-shaped JSON so the regression diff can run
# against state/known-test-failures.txt (which should stay empty).
LOOP_TEST_JSON_CMD="bash tests/selftest-report.sh {report}"
LOOP_TEST_CMD="bash tests/selftest.sh"
LOOP_LINT_CMD="python3 plugins/loopkit/scripts/check-skills.py --plugin plugins/loopkit --strict"
LOOP_LINT_FALLBACK_CMD=
LOOP_TYPECHECK_CMD=
LOOP_BUILD_CMD="claude plugin validate ."
LOOP_CODE_GLOBS="*.py *.sh *.mjs *.json"
LOOPKIT_REPO="luxtelos/loopkit"

# Where heavy runs belong. The Mac reports three symlink-related failures and a
# flaky wall-clock timing check, and on 2026-09-07 had ~48 MB of 16 GB free at
# load 49-91 while the remote had 18 GB free and 8 idle cores. Set this and use
# tools/remote-gate.sh; leave it empty to run locally and accept the noise.
#
# `:-` IS THE WHOLE POINT, and these two keys are the only ones in this file
# that get it. Eight scripts source this file with `set -a`, so a bare
# LOOPKIT_REMOTE="" overwrote a correct exported value with nothing — a config
# key that takes a working setting away. The LOOP_* keys above are read as
# `${VAR-default}`, where an explicit empty means "skip this step" and the
# clobber is the documented contract. These two have no such contract: unset or
# empty here must leave whatever the environment already holds.
LOOPKIT_REMOTE="${LOOPKIT_REMOTE:-}"
LOOPKIT_SSH_KEY="${LOOPKIT_SSH_KEY:-}"
