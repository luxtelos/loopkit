{
  "name": "05-draft-concept-not-enforceable",
  "description": "Two policy concepts. `/loop/never-merge.md` is human-verified and stable, so it is enforceable and is passed to the agent whose lane matches its tags. `/loop/agent-guess.md` was generated by a `process:` actor: its status is draft and its trust tier is `unverified`, so it must NOT be passed as enforceable however it is tagged. An agent writing knowledge back does so only as a mailbox Message, and that message lands the concept at status draft.",
  "input": {
    "queue": [
      { "finding": "judge runner", "source": "gh#104", "priority": "high", "spec": "specs/pairwise-judge-verdicts.md", "status": "fixing" }
    ],
    "policy": {
      "concepts": [
        {
          "path": "/loop/never-merge.md",
          "frontmatter": {
            "type": "invariant",
            "title": "Never merge",
            "tags": ["reviewer", "loop"],
            "status": "stable",
            "okf_version": "0.2",
            "generated": { "by": "human:owner", "at": "2026-09-01T00:00:00Z" },
            "verified": { "by": "human:owner", "at": "2026-09-01T00:00:00Z" }
          },
          "body": "The agent that wrote the code is never the agent that approves it."
        },
        {
          "path": "/loop/agent-guess.md",
          "frontmatter": {
            "type": "trap",
            "title": "Retry the gate twice",
            "tags": ["reviewer"],
            "status": "draft",
            "okf_version": "0.2",
            "generated": { "by": "process:loopkit-runner", "at": "2026-09-07T00:00:00Z" }
          },
          "body": "Proposed by an agent. Not ratified."
        }
      ]
    },
    "journal": []
  },
  "expected": {
    "stage": "fixing",
    "next": "CONTINUE",
    "counts": { "pr-open": 0, "fixing": 1, "spec-ready": 0, "spec-draft": 0, "new": 0, "blocked": 0 },
    "targets": [ { "stage": "fixing", "finding": "judge runner", "source": "gh#104" } ],
    "enforceable": ["/loop/never-merge.md"],
    "trust_tiers": { "/loop/never-merge.md": "human-reviewed", "/loop/agent-guess.md": "unverified" },
    "events": [ { "event": "stage", "stage": "fixing", "scope": "" } ],
    "messages": [
      {
        "type": "okf.message",
        "schema": "okf-mailbox/1",
        "op": "upsert",
        "target": "/loop/agent-guess.md",
        "enqueued_by": "process:loopkit-runner",
        "idempotency_key": "k-agent-guess-1",
        "reason": "agent proposal, unratified",
        "payload": { "status": "draft" }
      }
    ]
  }
}
